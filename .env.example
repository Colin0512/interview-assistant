# Main OpenAI-compatible provider (vision and general answers)
API_BASE_URL=https://example.com/v1
API_KEY=replace-with-your-main-api-key
MODEL=replace-with-your-vision-model

# Optional dedicated low-latency provider for spoken answers
VOICE_API_BASE_URL=https://example.com/v1
VOICE_API_KEY=replace-with-your-voice-api-key
VOICE_MODEL=replace-with-your-fast-text-model

# DashScope real-time speech recognition
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# Optional local defaults. Prefer editing these in the app Settings page.
PERSONAL_INFO=
